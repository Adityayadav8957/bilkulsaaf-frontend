# Backend API origin (server-side only — used by next.config.ts rewrites and
# server-side data fetching). In production this should normally be an
# internal address, since the public-facing /api/* path is what the browser
# and search engines ever see.
API_ORIGIN=http://127.0.0.1:5000/api

# Public site origin, used to build absolute canonical/OG URLs and the sitemap.
NEXT_PUBLIC_SITE_URL=https://definitelynotcorrupt.example
